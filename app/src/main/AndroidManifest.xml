<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Android 13+ 通知权限 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Android 16+ 实时更新（Live Updates）：允许系统把进行中的练习提升为状态栏胶囊 / 灵动岛。
         普通权限，安装时授予；旧系统会忽略。 -->
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />

    <!-- 关键交互的触感反馈（长按 / 拖拽 / 下拉达阈值等） -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- 保存赞赏码图片到系统相册：Android 10+ 走 MediaStore 不需要权限，
         只有 9 及以下要写公共 Pictures 目录，故按 maxSdkVersion 收口，不影响新系统的权限面。 -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <!-- AI 对话需要网络 -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- 硬件能力声明（全部 required=false，不排除任何设备，仅用于大屏/手写笔分发的筛选与优化） -->
    <!-- 触摸屏非必需：允许极少数无触摸设备安装（外接笔 / 键鼠场景） -->
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <!-- 手写笔：声明为「可选」。声明后应用可进入平板/手写笔类设备的推荐位；
         应用在无笔设备上功能完整（笔输入入口自动隐藏，键盘输入不受影响）。 -->
    <uses-feature android:name="android.hardware.stylus" android:required="false" />

    <!-- resizeableActivity=true 是系统「长按悬浮通知下拉呼出小窗」的前提：
         只有应用可调整窗口时，系统才会把通知点击放进自由窗口而不是强制全屏。
         活动也不锁方向，小窗横竖切换不会重建任务。不要改成 false。 -->
    <application
        android:name=".BlancallApp"
        android:enableOnBackInvokedCallback="true"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:networkSecurityConfig="@xml/network_security_config"
        android:resizeableActivity="true"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Blancall">
        <!-- 屏幕方向：不再锁定竖屏，交给系统 + 自适应布局处理。
             平板横屏是手写笔（S Pen / M-Pencil）最佳使用姿态，锁竖屏等于放弃这部分用户。
             曾经锁竖屏的理由是「横屏下首页内容区仅 406dp 高，卡片网格被压成一行半」，
             该问题已由按可用宽度动态计算网格列数解决（见 ui/common/Adaptive.kt）。 -->
        <!-- launchMode=singleTask：桌面图标重复点击 / Home 后立即切回时**复用同一实例**
             （真机反馈：standard 模式下会新建实例叠回「首页」，用户视角是「刚操作的页面被退掉了」）。
             复用实例后走 onNewIntent，Compose 导航栈与页面状态原样保留。 -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:resizeableActivity="true"
            android:theme="@style/Theme.Blancall.Splash"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- 系统分享文本 → 确认切句页。绝不静默建文章：分享内容常带导航栏/广告/乱码 -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />

                <category android:name="android.intent.category.DEFAULT" />

                <data android:mimeType="text/plain" />
            </intent-filter>

            <!-- 文本选择菜单里的「Blancall」：与分享同一确认页 -->
            <intent-filter>
                <action android:name="android.intent.action.PROCESS_TEXT" />

                <category android:name="android.intent.category.DEFAULT" />

                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- 桌面小组件：2x2 / 4x2，今日到期数与每日一句 -->
        <receiver
            android:name=".widget.BlancallWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>

            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/blancall_widget_info" />
        </receiver>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>