# IDE / 编辑器
/.idea/
*.iml

# 构建产物（递归忽略所有模块的 build 目录，不只是根目录）
**/build/
/build
/captures
.externalNativeBuild
.cxx

# Gradle
.gradle

# 本地配置（含签名信息，切勿提交）
/local.properties
local.properties

# 系统 / 临时
.DS_Store

# 导出的 APK / 中间产物
apk-output/
*.apk
*.aar
*.ap_

# Kotlin IDE 缓存/日志
.kotlin

# 个人开发工具与笔记（不入库）
.workbuddy
docs

build_compile.log

# 本地临时脚本与产物（严格不入库，仅本地保留）
*.py
*.mp4
hs_err_*.log
*.txt
# CMakeLists.txt 是 native 构建脚本，不能被 *.txt 误伤（否则全新 clone 无法构建 native）
!app/src/main/cpp/CMakeLists.txt

# 其它本地开发工具目录
.qoder/
.trae/

# JVM 崩溃转储与回放日志（构建中断产物）
hs_err_pid*.log
replay_pid*.log
